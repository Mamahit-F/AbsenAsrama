.env.*.local
*.key
*.pem
*.p12
*.jks
backend/.env*
frontend/.env*
ai_service/.env*

# 2. Node Dependencies
node_modules/
frontend/node_modules/
.npm/

# 3. Python Virtual Environments & Cache
venv/
.venv/
env/
ENV/
__pycache__/
*/__pycache__/
ai_service/__pycache__/
*.py[cod]
